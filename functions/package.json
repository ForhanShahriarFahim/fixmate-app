{
  "name": "fixmate-spark-tools",
  "private": true,
  "engines": { "node": "22" },
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "npm run build && node --test \"lib/**/*.test.js\"",
    "test:rules": "firebase emulators:exec --project fixmate-test --only firestore \"npm run build && node --test lib/firestore.rules.test.js\"",
    "seed": "npm run build && node lib/seed.js"
  },
  "dependencies": {
    "firebase-admin": "13.10.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "@types/node": "22.20.1",
    "firebase": "11.10.0",
    "firebase-tools": "15.24.0",
    "typescript": "5.9.3"
  }
}
