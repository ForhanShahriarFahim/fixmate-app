rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function image() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    function activeUser(uid) {
      return signedIn() && request.auth.uid == uid && request.auth.token.email_verified == true &&
        firestore.get(/databases/(default)/documents/users/$(uid)).data.status == 'active' &&
        firestore.get(/databases/(default)/documents/users/$(uid)).data.isAdultConfirmed == true &&
        firestore.get(/databases/(default)/documents/users/$(uid)).data.termsVersion == '1.0';
    }
    function approvedProvider(uid) {
      return activeUser(uid) &&
        firestore.get(/databases/(default)/documents/provider_profiles/$(uid)).data.approvalStatus == 'approved';
    }

    match /users/{uid}/avatar/{fileName} {
      allow read: if true;
      allow write: if activeUser(uid) && image() && request.resource.size < 2 * 1024 * 1024;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /services/{uid}/{serviceId}/{fileName} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid && approvedProvider(uid) &&
        image() && request.resource.size < 5 * 1024 * 1024;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
